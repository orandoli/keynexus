# =========================================================
# PWDSV 生产环境配置模板（由 tools/init-server.ps1 或 init-server.sh 自动生成 .env）
# =========================================================

# 1. 访问域名与反向代理主机名
# 公网模式示例：DOMAIN=https://vault.example.com  CADDY_HOST=vault.example.com
# 内网/Tailscale 示例：DOMAIN=https://100.64.0.10:8443  CADDY_HOST=100.64.0.10:8443
DOMAIN=https://vault.example.com
CADDY_HOST=vault.example.com
HTTP_PORT=80
HTTPS_PORT=443

# 2. 安全与注册控制（首次注册好自己的账号后，强烈建议改为 false）
SIGNUPS_ALLOWED=true
WEBSOCKET_ENABLED=true

# 3. 放行浏览器插件与 Windows 桌面客户端跨域实时推送
ALLOWED_CLIENT_ORIGINS=chrome-extension://*,tauri://localhost,http://tauri.localhost,https://tauri.localhost

# 4. 管理后台令牌（使用 Argon2id PHC 格式；通过 env_file 注入无需双写 $$）
ADMIN_TOKEN=

# 5. 自动备份保留策略
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=30
