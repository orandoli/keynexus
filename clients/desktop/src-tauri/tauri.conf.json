{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeyNexus",
  "version": "2.0.11",
  "identifier": "com.pwdsv.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "KeyNexus",
        "url": "index.html",
        "width": 1000,
        "height": 680,
        "minWidth": 840,
        "minHeight": 540,
        "center": true
      },
      {
        "label": "hud",
        "title": "KeyNexus HUD",
        "url": "hud.html",
        "width": 376,
        "height": 168,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
