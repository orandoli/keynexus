{
  "manifest_version": 3,
  "name": "KeyNexus",
  "version": "2.0.8",
  "description": "KeyNexus 零知识加密助手：自动记录网站密码、下次登录主动提示、手动提交管理密码、TOTP 自动填入，与桌面端及手机端四态实时同步。",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "src/icons/16.png",
    "32": "src/icons/32.png",
    "48": "src/icons/48.png",
    "128": "src/icons/128.png"
  },
  "action": {
    "default_title": "KeyNexus",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "src/icons/16.png",
      "32": "src/icons/32.png",
      "48": "src/icons/48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": [
    "storage",
    "alarms",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "commands": {
    "fill_login": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "用 KeyNexus 填充当前登录表单"
    }
  }
}
